---
import Socials from "./Socials.astro"
import WorkButton from "./WorkButton.astro"
import PhoneButton from "./PhoneButton.astro"
import EmailButton from "./EmailButton.astro"
---

<section>
  <div class="div-container" data-scroll-to="divContainer" id="conocenos">
    <h2>Ubicación y contacto de TrainZone</h2>
    <div class="info-wrapper">
      <article class="article-info">
        <p>
          <span class="p-txt">
            <span class="span-text">TLF: 671597133</span>
            <span class="span-text">E-mail: centrotrainzone@gmail.com</span>
          </span>
        </p>
        <div class="addresses">
          <p class="address">
            <span class="span-text"><strong>Bollullos Par del Condado</strong></span>
            <span class="span-text">Calle Fernando Escartín, Nº 12. Huelva.</span>
          </p>
          <p class="address">
            <span class="span-text"><strong>Espartinas</strong></span>
            <span class="span-text">C. Padre Claudio López, Nº 16. Sevilla.</span>
          </p>
        </div>
        <div class="div-parent">
          <div class="div-button-wrapper">
            <PhoneButton />
            <EmailButton />
          </div>
          <WorkButton />
          <Socials />
        </div>
      </article>
      <div class="map-tabs">
        <input type="radio" name="centro" id="mapa-bollullos" checked />
        <input type="radio" name="centro" id="mapa-espartinas" />
        <div class="tab-buttons">
          <label for="mapa-bollullos">Bollullos (Huelva)</label>
          <label for="mapa-espartinas">Espartinas (Sevilla)</label>
        </div>
        <iframe
          title="Mapa TrainZone Bollullos Par del Condado"
          class="map map-bollullos"
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d12688.132882684664!2d-6.5328454!3d37.3417222!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd11f1088700e8fd%3A0x3a93db66def6f945!2sTRAINZONE!5e0!3m2!1ses!2ses!4v1694453591308!5m2!1ses!2ses"
          loading="lazy"
        >
        </iframe>
        <iframe
          title="Mapa TrainZone Espartinas"
          class="map map-espartinas"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12688.132882684664!2d-6.12245200302553!3d37.38069714554437!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd12130005aa692f%3A0x31270aaa225e758c!2s%E2%96%B7%20Trainzone%20-%20Entrenamiento%20personal%20Espartinas!5e0!3m2!1ses!2ses!4v1792319301751!5m2!1ses!2ses"
          loading="lazy"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>
<style>
  section {
    align-self: stretch;
    background-color: #3b3b3b;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0 1rem;
    text-align: left;
    color: white;
  }
  .div-container {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 0;
    box-sizing: border-box;
    gap: 2rem;
    max-width: 71.25rem;
  }
  h2 {
    margin: 0;
    position: relative;
    line-height: 3rem;
    font-weight: 700;
    font-size: 1.5rem;
  }
  .info-wrapper {
    align-self: stretch;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 2rem;
  }
  .article-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 2rem;
    text-align: left;
    font-size: 1rem;
    color: #efefef;
  }
  p {
    display: flex;
    align-items: center;
    margin: 0;
    position: relative;
    line-height: 1.5rem;
    width: 22.38rem;
  }
  span {
    line-break: anywhere;
    width: 100%;
  }
  .span-text {
    display: block;
  }
  .div-parent {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    align-self: stretch;
    gap: 1rem;
    text-align: center;
    font-size: 1.13rem;
    color: #fefefe;
  }
  .div-button-wrapper {
    align-self: stretch;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: stretch;
    gap: 1rem;
  }
  .addresses {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .address {
    flex-direction: column;
    align-items: flex-start;
    border-left: 3px solid var(--accent-teal-light);
    padding-left: 0.75rem;
    box-sizing: border-box;
  }
  .map-tabs {
    flex: 1;
    min-width: 15.63rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .map-tabs input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tab-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  label {
    padding: 0.6rem 1.1rem;
    border-radius: 32px;
    background-color: #595959;
    cursor: pointer;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  label:hover {
    background-color: #4f4f4f;
  }
  #mapa-bollullos:checked ~ .tab-buttons label[for="mapa-bollullos"],
  #mapa-espartinas:checked ~ .tab-buttons label[for="mapa-espartinas"] {
    background-color: var(--accent-teal-light);
  }
  #mapa-bollullos:focus-visible ~ .tab-buttons label[for="mapa-bollullos"],
  #mapa-espartinas:focus-visible ~ .tab-buttons label[for="mapa-espartinas"] {
    outline: 2px solid white;
    outline-offset: 2px;
  }
  iframe {
    border: 0;
    position: relative;
    border-radius: 1rem;
    height: 22rem;
    width: 100%;
    overflow: hidden;
    display: none;
  }
  #mapa-bollullos:checked ~ .map-bollullos,
  #mapa-espartinas:checked ~ .map-espartinas {
    display: block;
  }
  @media screen and (max-width: 805px) {
    .div-button-wrapper {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: stretch;
      gap: 1rem;
    }
    .article-info {
      width: 100%;
    }
  }
  @media screen and (max-width: 520px) {
    .div-button-wrapper {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: stretch;
      gap: 1rem;
    }
  }

  @media screen and (max-width: 420px) {
    .info-wrapper {
      flex-direction: row;
      gap: 1rem;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .article-info {
      flex: 1;
    }
    p {
      align-self: stretch;
      width: auto;
    }
  }
</style>
